  {
    "id": "n_twin_a251_build",
    "type": "function",
    "z": "d54aff3e6a0e6e69",
    "name": "Build A25-1 Telemetry",
    "func": "var p = msg.payload || {};\nvar recovery = Number(p.recovery);\nvar pFeed = Number(p.pressure);\nif (isNaN(pFeed)) pFeed = Number(p.hppPressure);\nvar dpTmp = Number(p.dpTmp);\nvar qFeed = Number(p.feedFlow);\nvar qPerm = qFeed * recovery / 100;\nvar telemetry = {\n  train_id: 'A25-1',\n  ts: p.ts || Date.now(),\n  P_feed: pFeed,\n  P_ret: pFeed - dpTmp,\n  P_perm: 0.5,\n  Q_feed: qFeed,\n  Q_perm: qPerm,\n  Q_ret: qFeed - qPerm,\n  Temp: Number(p.feedTemp),\n  TDS_feed: Number(p.feedTds),\n  TDS_perm: Number(p.permeateTds),\n  Power_HPP: 500,\n  Power_ERS: 300 * ((Number(p.eriEfficiency)||96) / 96)\n};\nvar specs = { Membrane_Area: 11446.4, Rm: 4.5e14 };\nmsg.payload = Buffer.from(JSON.stringify({ telemetry: telemetry, specs: specs })).toString('base64');\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 80,
    "wires": [
