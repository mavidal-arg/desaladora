  {
    "id": "n_twin_a251_parse",
    "type": "function",
    "z": "d54aff3e6a0e6e69",
    "name": "Parse A25-1 Calculated",
    "func": "var c;\ntry { c = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload; }\ncatch (e) { node.error('C1 parse error: ' + e + ' raw=' + msg.payload); return null; }\nif (!c || typeof c.R_f === 'undefined') { node.warn('empty C1'); return null; }\nvar post = RED.util.cloneMessage(msg);\npost.payload = c;\npost.headers = { 'Content-Type': 'application/json' };\n// salud derivada [inferencia]: castiga polarizacion y fouling\nvar health = 100;\nif (c.beta > 1.15) health -= (c.beta - 1.15) * 200;\nif (c.Rf_norm > 0) health -= Math.min(40, c.Rf_norm / c.R_Total * 100);\nhealth = Math.max(0, Math.min(100, Math.round(health)));\nvar trend = (c.cip_days !== null && c.cip_days < 14) ? 'critical' : (c.Rf_norm > 0 ? 'rising' : 'stable');\nvar healthMsg = { topic: 'v1/DPCQ01/RO/A25-1/State/health', payload: { value: health, trend: trend, updatedAt: Date.now() } };\nreturn [post, healthMsg];",
