    "z": "d54aff3e6a0e6e69",
    "name": "Format CIP Action",
    "func": "var d = msg.payload;\nif (!d || !d.trainCode) return null;\nvar action = { topic: 'v1/DPCQ01/CIP/Action/cipAlert', payload: {\n  cmdId: 'cip-' + Date.now(), trainCode: d.trainCode,\n  trigger: d.trigger || 'rf_threshold', cipDays: d.cipDays,\n  rfNorm: d.rfNorm, requestedAt: Date.now() } };\nvar info = null;\nif (d.lastEvent) { info = { topic: 'v1/DPCQ01/CIP/Info/cipExecuted', payload: {\n  eventId: 'cipev-' + d.lastEvent.day, trainCode: d.lastEvent.trainCode,\n  rfBefore: d.lastEvent.rfBefore, rfAfter: d.lastEvent.rfAfter, ts: Date.now() } }; }\nreturn [action, info];",
